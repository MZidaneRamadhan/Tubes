{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "if (!(Test-Path bin)) { mkdir bin }; gcc src/*.c src/*/*.c -Iinclude -o bin/main",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run",
            "type": "shell",
            "dependsOn": "build",
            "command": "./bin/main"
        }
    ]
}